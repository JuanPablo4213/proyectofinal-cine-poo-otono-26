digraph G {
graph [rankdir=BT, nodesep=0.4, ranksep=0.7, fontname="Helvetica", label="Diagrama de clases – módulo cinemex.funciones", labelloc=t, fontsize=18, pad=0.3];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9];
"Idioma" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F3E5F5"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Idioma</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ESPANOL<BR ALIGN="LEFT"/>SUBTITULADA<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOFuncion" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F3E5F5"><B>POJOFuncion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _id: int<BR ALIGN="LEFT"/>- _pelicula: POJOPelicula<BR ALIGN="LEFT"/>- _sala: POJOSala<BR ALIGN="LEFT"/>- _fechaHora: LocalDateTime<BR ALIGN="LEFT"/>- _idioma: Idioma<BR ALIGN="LEFT"/>- _asientosOcupados: List&lt;POJOAsiento&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ POJOFuncion(id, pelicula, sala, fechaHora, idioma)<BR ALIGN="LEFT"/>+ estaDisponible(a: POJOAsiento): boolean<BR ALIGN="LEFT"/>+ ocupar(a: POJOAsiento): boolean<BR ALIGN="LEFT"/>+ liberar(a: POJOAsiento): void<BR ALIGN="LEFT"/>+ getAsientosDisponibles(): List&lt;POJOAsiento&gt;<BR ALIGN="LEFT"/>+ calcularHoraFin(): LocalDateTime<BR ALIGN="LEFT"/>+ getters()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ServicioFunciones" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F3E5F5"><B>ServicioFunciones</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _funciones: List&lt;POJOFuncion&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ guardar(obj: POJOFuncion): boolean<BR ALIGN="LEFT"/>+ buscarPorId(id: int): POJOFuncion<BR ALIGN="LEFT"/>+ listar(): List&lt;POJOFuncion&gt;<BR ALIGN="LEFT"/>+ listarPorPelicula(p: POJOPelicula): List&lt;POJOFuncion&gt;<BR ALIGN="LEFT"/>+ listarPorCineYPelicula(c: POJOCine, p: POJOPelicula, dia: LocalDate): List&lt;POJOFuncion&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"MenuFunciones" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F3E5F5"><B>MenuFunciones</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _servicio: ServicioFunciones<BR ALIGN="LEFT"/>- _peliculas: ServicioPeliculas<BR ALIGN="LEFT"/>- _cines: ServicioCines<BR ALIGN="LEFT"/>- _usuarios: ServicioUsuarios<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getTitulo(): String<BR ALIGN="LEFT"/>+ mostrar(sc: Scanner): void<BR ALIGN="LEFT"/>- verHorarios(sc: Scanner): void<BR ALIGN="LEFT"/>- verAsientos(sc: Scanner): void<BR ALIGN="LEFT"/>- programarFuncion(sc: Scanner): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IMenu" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#ECEFF1" STYLE="dashed"><FONT POINT-SIZE="8">«interface» </FONT>IMenu<BR/><FONT POINT-SIZE="8" COLOR="#666666">(cinemex.base)</FONT></TD></TR></TABLE>>];
"POJOPelicula" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFF3E0" STYLE="dashed">POJOPelicula<BR/><FONT POINT-SIZE="8" COLOR="#666666">(cinemex.peliculas)</FONT></TD></TR></TABLE>>];
"POJOSala" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F5E9" STYLE="dashed"><FONT POINT-SIZE="8">«abstract» </FONT>POJOSala<BR/><FONT POINT-SIZE="8" COLOR="#666666">(cinemex.cines)</FONT></TD></TR></TABLE>>];
"POJOAsiento" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F5E9" STYLE="dashed">POJOAsiento<BR/><FONT POINT-SIZE="8" COLOR="#666666">(cinemex.cines)</FONT></TD></TR></TABLE>>];
"POJOCompra" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFEBEE" STYLE="dashed">POJOCompra<BR/><FONT POINT-SIZE="8" COLOR="#666666">(cinemex.compras)</FONT></TD></TR></TABLE>>];
"MenuFunciones" -> "IMenu" [arrowhead=empty, style=dashed];
"POJOFuncion" -> "POJOPelicula" [arrowhead=vee, label="proyecta", taillabel="0..*", headlabel="1"];
"POJOFuncion" -> "POJOSala" [arrowhead=vee, label="se da en", taillabel="0..*", headlabel="1"];
"POJOFuncion" -> "POJOAsiento" [arrowhead=vee, label="ocupados", headlabel="0..*"];
"POJOFuncion" -> "Idioma" [arrowhead=vee, headlabel="1"];
"POJOCompra" -> "POJOFuncion" [arrowhead=vee, label="para", taillabel="0..*", headlabel="1"];
"ServicioFunciones" -> "POJOFuncion" [arrowtail=odiamond, dir=back, arrowhead=vee, label="administra", taillabel="1", headlabel="0..*"];
"MenuFunciones" -> "ServicioFunciones" [arrowhead=vee, style=dashed, color="#777777", fontcolor="#777777", label="usa"];
}