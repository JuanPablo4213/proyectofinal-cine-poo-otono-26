digraph G {
graph [rankdir=BT, nodesep=0.4, ranksep=0.7, fontname="Helvetica", label="Diagrama de clases – módulo cinemex.controlador", labelloc=t, fontsize=18, pad=0.3];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9];
"Contexto" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#EDE7F6"><B>Contexto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- servicios (5)<BR ALIGN="LEFT"/>- _catalogo: IClientePeliculas<BR ALIGN="LEFT"/>- _navegador: Navegador<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ usuarios() ... compras(): Servicio<BR ALIGN="LEFT"/>+ catalogo(): IClientePeliculas<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Navegador" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#EDE7F6"><B>Navegador</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _historial: Deque&lt;Parent&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ iniciar(): void<BR ALIGN="LEFT"/>+ ir(vista, preparar): T<BR ALIGN="LEFT"/>+ regresar(): void<BR ALIGN="LEFT"/>+ requiereSesion(accion): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ControladorBase" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#EDE7F6"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><B><I>ControladorBase</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># ctx: Contexto<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># alIniciar(): void<BR ALIGN="LEFT"/># mostrarError(e): void<BR ALIGN="LEFT"/># enSegundoPlano(trabajo, ok, error): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"CarteleraControlador" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#EDE7F6"><B>CarteleraControlador</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- cargar(pagina): void<BR ALIGN="LEFT"/>- mostrarPeliculas(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"DetalleControlador" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#EDE7F6"><B>DetalleControlador</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- importar(): void<BR ALIGN="LEFT"/>- comprar(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"CompraControlador" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#EDE7F6"><B>CompraControlador</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- dibujarMapa(): void<BR ALIGN="LEFT"/>- pagar(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"MiCineControlador" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#EDE7F6"><B>MiCineControlador</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
"MisComprasControlador" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#EDE7F6"><B>MisComprasControlador</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- cancelar(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"LoginControlador" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#EDE7F6"><B>LoginControlador</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- entrar(): void<BR ALIGN="LEFT"/>- registrar(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Admin*Controlador (3)" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#EDE7F6"><B>Admin*Controlador (3)</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">CRUD películas / cines y salas / funciones<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"Tareas" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#EDE7F6"><B>Tareas</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ enSegundoPlano(trabajo, ok, error): void {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IClientePeliculas" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FCE4EC" STYLE="dashed"><FONT POINT-SIZE="8">«interface» </FONT>IClientePeliculas<BR/><FONT POINT-SIZE="8" COLOR="#666666">(cinemex.catalogo)</FONT></TD></TR></TABLE>>];
"CarteleraControlador" -> "ControladorBase" [arrowhead=empty, style=solid];
"DetalleControlador" -> "ControladorBase" [arrowhead=empty, style=solid];
"CompraControlador" -> "ControladorBase" [arrowhead=empty, style=solid];
"MiCineControlador" -> "ControladorBase" [arrowhead=empty, style=solid];
"MisComprasControlador" -> "ControladorBase" [arrowhead=empty, style=solid];
"LoginControlador" -> "ControladorBase" [arrowhead=empty, style=solid];
"Admin*Controlador (3)" -> "ControladorBase" [arrowhead=empty, style=solid];
"Contexto" -> "IClientePeliculas" [arrowhead=vee, label="catalogo", headlabel="1"];
"Contexto" -> "Navegador" [arrowhead=vee, headlabel="1"];
"ControladorBase" -> "Contexto" [arrowhead=vee, label="ctx", headlabel="1"];
"ControladorBase" -> "Tareas" [arrowhead=vee, style=dashed, color="#777777", fontcolor="#777777", label="usa"];
}