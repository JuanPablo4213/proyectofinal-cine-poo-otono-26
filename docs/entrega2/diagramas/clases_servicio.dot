digraph G {
graph [rankdir=BT, nodesep=0.4, ranksep=0.7, fontname="Helvetica", label="Diagrama de clases – módulo cinemex.servicio", labelloc=t, fontsize=18, pad=0.3];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9];
"ServicioUsuarios" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFDE7"><B>ServicioUsuarios</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _usuarioActual: POJOUsuario<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ guardar(obj: POJOUsuario): boolean<BR ALIGN="LEFT"/>+ registrarCliente(nombre, email, tel, password): POJOCliente<BR ALIGN="LEFT"/>+ buscarPorId(id): POJOUsuario<BR ALIGN="LEFT"/>+ buscarPorEmail(email): POJOUsuario<BR ALIGN="LEFT"/>+ listar(): List<BR ALIGN="LEFT"/>+ iniciarSesion(email, password): POJOUsuario<BR ALIGN="LEFT"/>+ cerrarSesion(): void<BR ALIGN="LEFT"/>+ getUsuarioActual(): POJOUsuario<BR ALIGN="LEFT"/>+ getClienteActual(): POJOCliente<BR ALIGN="LEFT"/>+ esAdministrador(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ServicioPeliculas" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFDE7"><B>ServicioPeliculas</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ guardar(obj: POJOPelicula): boolean<BR ALIGN="LEFT"/>+ actualizar(obj): boolean<BR ALIGN="LEFT"/>+ eliminar(id): boolean<BR ALIGN="LEFT"/>+ buscarPorId(id): POJOPelicula<BR ALIGN="LEFT"/>+ buscarPorTmdbId(tmdbId): POJOPelicula<BR ALIGN="LEFT"/>+ listar(): List<BR ALIGN="LEFT"/>+ listarCartelera(): List<BR ALIGN="LEFT"/>+ buscar(filtros: List&lt;IFiltroPelicula&gt;): List<BR ALIGN="LEFT"/>+ sincronizarGeneros(generos): void<BR ALIGN="LEFT"/>+ listarGeneros(): List&lt;POJOGenero&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ServicioCines" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFDE7"><B>ServicioCines</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ guardar(obj: POJOCine): boolean<BR ALIGN="LEFT"/>+ eliminar(id): boolean<BR ALIGN="LEFT"/>+ buscarPorId(id): POJOCine<BR ALIGN="LEFT"/>+ listar(): List<BR ALIGN="LEFT"/>+ listarPorCiudad(ciudad): List<BR ALIGN="LEFT"/>+ listarCiudades(): List&lt;String&gt;<BR ALIGN="LEFT"/>+ crearSala(tipo, id, cineId, numero, filas, columnas, cargo): POJOSala<BR ALIGN="LEFT"/>+ agregarSala(cine, sala): boolean<BR ALIGN="LEFT"/>+ eliminarSala(salaId): boolean<BR ALIGN="LEFT"/>+ cargarAsientos(sala): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ServicioFunciones" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFDE7"><B>ServicioFunciones</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _peliculas: ServicioPeliculas<BR ALIGN="LEFT"/>- _cines: ServicioCines<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ guardar(obj: POJOFuncion): boolean<BR ALIGN="LEFT"/>+ eliminar(id): boolean<BR ALIGN="LEFT"/>+ buscarPorId(id): POJOFuncion<BR ALIGN="LEFT"/>+ listar(): List<BR ALIGN="LEFT"/>+ listarPorPelicula(p): List<BR ALIGN="LEFT"/>+ listarPorCineYPelicula(c, p, dia): List<BR ALIGN="LEFT"/>+ listarPorCineYDia(c, dia): List<BR ALIGN="LEFT"/>+ cargarOcupados(f): void<BR ALIGN="LEFT"/>+ contarBoletos(funcionId): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ServicioCompras" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFFDE7"><B>ServicioCompras</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _funciones: ServicioFunciones<BR ALIGN="LEFT"/>+ MAX_BOLETOS: int = 10 {static}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ iniciarCompra(c: POJOCliente, f: POJOFuncion): POJOCompra<BR ALIGN="LEFT"/>+ agregarBoleto(compra, a, tipo): boolean<BR ALIGN="LEFT"/>+ confirmarCompra(compra, m: IMetodoPago): boolean<BR ALIGN="LEFT"/>+ cancelar(id): boolean<BR ALIGN="LEFT"/>+ buscarPorId(id): POJOCompra<BR ALIGN="LEFT"/>+ listarPorCliente(c): List&lt;POJOCompra&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOUsuario" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E3F2FD" STYLE="dashed"><FONT POINT-SIZE="8">«abstract» </FONT>POJOUsuario<BR/><FONT POINT-SIZE="8" COLOR="#666666">(cinemex.modelo.usuarios)</FONT></TD></TR></TABLE>>];
"POJOPelicula" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFF3E0" STYLE="dashed">POJOPelicula<BR/><FONT POINT-SIZE="8" COLOR="#666666">(cinemex.modelo.peliculas)</FONT></TD></TR></TABLE>>];
"IFiltroPelicula" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFF3E0" STYLE="dashed"><FONT POINT-SIZE="8">«interface» </FONT>IFiltroPelicula<BR/><FONT POINT-SIZE="8" COLOR="#666666">(cinemex.modelo.peliculas)</FONT></TD></TR></TABLE>>];
"POJOCine" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F5E9" STYLE="dashed">POJOCine<BR/><FONT POINT-SIZE="8" COLOR="#666666">(cinemex.modelo.cines)</FONT></TD></TR></TABLE>>];
"POJOFuncion" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F3E5F5" STYLE="dashed">POJOFuncion<BR/><FONT POINT-SIZE="8" COLOR="#666666">(cinemex.modelo.funciones)</FONT></TD></TR></TABLE>>];
"POJOCompra" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFEBEE" STYLE="dashed">POJOCompra<BR/><FONT POINT-SIZE="8" COLOR="#666666">(cinemex.modelo.compras)</FONT></TD></TR></TABLE>>];
"ServicioUsuarios" -> "POJOUsuario" [arrowhead=vee, style=dashed, color="#777777", fontcolor="#777777", label="administra"];
"ServicioPeliculas" -> "POJOPelicula" [arrowhead=vee, style=dashed, color="#777777", fontcolor="#777777", label="administra"];
"ServicioPeliculas" -> "IFiltroPelicula" [arrowhead=vee, style=dashed, color="#777777", fontcolor="#777777", label="usa"];
"ServicioCines" -> "POJOCine" [arrowhead=vee, style=dashed, color="#777777", fontcolor="#777777", label="administra"];
"ServicioFunciones" -> "POJOFuncion" [arrowhead=vee, style=dashed, color="#777777", fontcolor="#777777", label="administra"];
"ServicioFunciones" -> "ServicioPeliculas" [arrowhead=vee, headlabel="1"];
"ServicioFunciones" -> "ServicioCines" [arrowhead=vee, headlabel="1"];
"ServicioCompras" -> "ServicioFunciones" [arrowhead=vee, headlabel="1"];
"ServicioCompras" -> "POJOCompra" [arrowhead=vee, style=dashed, color="#777777", fontcolor="#777777", label="administra"];
}