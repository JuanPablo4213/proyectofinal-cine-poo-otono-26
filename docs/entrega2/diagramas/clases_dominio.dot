digraph G {
graph [rankdir=BT, splines=true, nodesep=0.35, ranksep=0.6, fontname="Helvetica", label="Diagrama de clases (Entrega 2) – Clon de Cinemex", labelloc=t, fontsize=20, pad=0.3];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9];
subgraph cluster_usuarios { label="cinemex.modelo.usuarios"; style="rounded,dashed"; color="#90A4AE"; fontsize=13; fontcolor="#455A64";
"POJOUsuario" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E3F2FD"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><B><I>POJOUsuario</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># id: int<BR ALIGN="LEFT"/># nombre: String<BR ALIGN="LEFT"/># email: String<BR ALIGN="LEFT"/># passwordHash: String<BR ALIGN="LEFT"/># sal: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getRol(): String {abstract}<BR ALIGN="LEFT"/>+ validarPassword(password: String): boolean<BR ALIGN="LEFT"/>+ getters()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOCliente" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E3F2FD"><B>POJOCliente</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _telefono: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getRol(): String<BR ALIGN="LEFT"/>+ getTelefono(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOAdministrador" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E3F2FD"><B>POJOAdministrador</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _numEmpleado: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getRol(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_peliculas { label="cinemex.modelo.peliculas"; style="rounded,dashed"; color="#90A4AE"; fontsize=13; fontcolor="#455A64";
"Clasificacion" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF3E0"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Clasificacion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">AA<BR ALIGN="LEFT"/>A<BR ALIGN="LEFT"/>B<BR ALIGN="LEFT"/>B15<BR ALIGN="LEFT"/>C<BR ALIGN="LEFT"/>D<BR ALIGN="LEFT"/>SC<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOGenero" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF3E0"><B>POJOGenero</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _id: int<BR ALIGN="LEFT"/>- _nombre: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getters()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOPelicula" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF3E0"><B>POJOPelicula</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _id: int<BR ALIGN="LEFT"/>- _tmdbId: int<BR ALIGN="LEFT"/>- _titulo: String<BR ALIGN="LEFT"/>- _sinopsis: String<BR ALIGN="LEFT"/>- _duracionMin: int<BR ALIGN="LEFT"/>- _clasificacion: Clasificacion<BR ALIGN="LEFT"/>- _posterPath: String<BR ALIGN="LEFT"/>- _fechaEstreno: LocalDate<BR ALIGN="LEFT"/>- _calificacion: double<BR ALIGN="LEFT"/>- _enCartelera: boolean<BR ALIGN="LEFT"/>- _generos: List&lt;POJOGenero&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ estaImportada(): boolean<BR ALIGN="LEFT"/>+ getUrlPoster(): String<BR ALIGN="LEFT"/>+ getGenerosTexto(): String<BR ALIGN="LEFT"/>+ getters/setters()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IFiltroPelicula" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF3E0"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B><I>IFiltroPelicula</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ cumple(p: POJOPelicula): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"FiltroTitulo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF3E0"><B>FiltroTitulo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _texto: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ cumple(p): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"FiltroGenero" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF3E0"><B>FiltroGenero</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _genero: POJOGenero<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ cumple(p): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"FiltroClasificacion" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF3E0"><B>FiltroClasificacion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _clasificacion: Clasificacion<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ cumple(p): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_cines { label="cinemex.modelo.cines"; style="rounded,dashed"; color="#90A4AE"; fontsize=13; fontcolor="#455A64";
"POJOCine" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8F5E9"><B>POJOCine</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _id: int<BR ALIGN="LEFT"/>- _nombre: String<BR ALIGN="LEFT"/>- _ciudad: String<BR ALIGN="LEFT"/>- _direccion: String<BR ALIGN="LEFT"/>- _salas: List&lt;POJOSala&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ agregarSala(s: POJOSala): boolean<BR ALIGN="LEFT"/>+ tieneSala(s: POJOSala): boolean<BR ALIGN="LEFT"/>+ getters/setters()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOSala" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8F5E9"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><B><I>POJOSala</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># id: int<BR ALIGN="LEFT"/># cineId: int<BR ALIGN="LEFT"/># numero: int<BR ALIGN="LEFT"/># filas: int<BR ALIGN="LEFT"/># columnas: int<BR ALIGN="LEFT"/># asientos: List&lt;POJOAsiento&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calcularPrecio(tipo: TipoBoleto): double {abstract}<BR ALIGN="LEFT"/>+ getTipoSala(): String {abstract}<BR ALIGN="LEFT"/>+ buscarAsiento(fila: char, numero: int): POJOAsiento<BR ALIGN="LEFT"/>+ getCapacidad(): int<BR ALIGN="LEFT"/>+ setAsientos(lista): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOSalaTradicional" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8F5E9"><B>POJOSalaTradicional</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- PRECIO_BASE: double = 75 {static}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calcularPrecio(tipo): double<BR ALIGN="LEFT"/>+ getTipoSala(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOSalaPlatino" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8F5E9"><B>POJOSalaPlatino</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- PRECIO_BASE: double = 160 {static}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calcularPrecio(tipo): double<BR ALIGN="LEFT"/>+ getTipoSala(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOSalaX4D" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8F5E9"><B>POJOSalaX4D</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- PRECIO_BASE: double = 120 {static}<BR ALIGN="LEFT"/>- _cargoEfectos: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calcularPrecio(tipo): double<BR ALIGN="LEFT"/>+ getTipoSala(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOAsiento" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8F5E9"><B>POJOAsiento</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _id: int<BR ALIGN="LEFT"/>- _fila: char<BR ALIGN="LEFT"/>- _numero: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getCodigo(): String<BR ALIGN="LEFT"/>+ equals(o): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_funciones { label="cinemex.modelo.funciones"; style="rounded,dashed"; color="#90A4AE"; fontsize=13; fontcolor="#455A64";
"Idioma" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F3E5F5"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Idioma</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ESPANOL<BR ALIGN="LEFT"/>SUBTITULADA<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOFuncion" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F3E5F5"><B>POJOFuncion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _id: int<BR ALIGN="LEFT"/>- _pelicula: POJOPelicula<BR ALIGN="LEFT"/>- _cine: POJOCine<BR ALIGN="LEFT"/>- _sala: POJOSala<BR ALIGN="LEFT"/>- _fechaHora: LocalDateTime<BR ALIGN="LEFT"/>- _idioma: Idioma<BR ALIGN="LEFT"/>- _asientosOcupados: List&lt;POJOAsiento&gt;<BR ALIGN="LEFT"/>+ MINUTOS_LIMPIEZA: int = 20 {static}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ estaDisponible(a): boolean<BR ALIGN="LEFT"/>+ ocupar(a): boolean<BR ALIGN="LEFT"/>+ liberar(a): void<BR ALIGN="LEFT"/>+ getAsientosDisponibles(): List<BR ALIGN="LEFT"/>+ calcularHoraFin(): LocalDateTime<BR ALIGN="LEFT"/>+ yaEmpezo(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_compras { label="cinemex.modelo.compras"; style="rounded,dashed"; color="#90A4AE"; fontsize=13; fontcolor="#455A64";
"TipoBoleto" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>TipoBoleto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ADULTO (1.0)<BR ALIGN="LEFT"/>NINO (0.7)<BR ALIGN="LEFT"/>ADULTO_MAYOR (0.7)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"EstadoCompra" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>EstadoCompra</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PENDIENTE<BR ALIGN="LEFT"/>PAGADA<BR ALIGN="LEFT"/>CANCELADA<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOBoleto" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><B>POJOBoleto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _id: int<BR ALIGN="LEFT"/>- _funcion: POJOFuncion<BR ALIGN="LEFT"/>- _asiento: POJOAsiento<BR ALIGN="LEFT"/>- _tipo: TipoBoleto<BR ALIGN="LEFT"/>- _precio: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getters()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOCompra" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><B>POJOCompra</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ MAX_BOLETOS: int = 10 {static}<BR ALIGN="LEFT"/>- _id: int<BR ALIGN="LEFT"/>- _cliente: POJOCliente<BR ALIGN="LEFT"/>- _funcion: POJOFuncion<BR ALIGN="LEFT"/>- _boletos: List&lt;POJOBoleto&gt;<BR ALIGN="LEFT"/>- _metodo: IMetodoPago<BR ALIGN="LEFT"/>- _estado: EstadoCompra<BR ALIGN="LEFT"/>- _fecha: LocalDateTime<BR ALIGN="LEFT"/>- _comision: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ agregarBoleto(b): boolean<BR ALIGN="LEFT"/>+ tieneAsiento(a): boolean<BR ALIGN="LEFT"/>+ calcularTotal(): double<BR ALIGN="LEFT"/>+ getters/setters()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IMetodoPago" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B><I>IMetodoPago</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ validar(): boolean<BR ALIGN="LEFT"/>+ calcularComision(monto: double): double<BR ALIGN="LEFT"/>+ getNombre(): String<BR ALIGN="LEFT"/>+ getReferencia(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PagoTarjeta" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><B>PagoTarjeta</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _numeroTarjeta: String<BR ALIGN="LEFT"/>- _cvv: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ validar(): boolean<BR ALIGN="LEFT"/>+ calcularComision(monto): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PagoPayPal" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><B>PagoPayPal</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _correo: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ validar(): boolean<BR ALIGN="LEFT"/>+ calcularComision(monto): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
"POJOCliente" -> "POJOUsuario" [arrowhead=empty, style=solid];
"POJOAdministrador" -> "POJOUsuario" [arrowhead=empty, style=solid];
"POJOSalaTradicional" -> "POJOSala" [arrowhead=empty, style=solid];
"POJOSalaPlatino" -> "POJOSala" [arrowhead=empty, style=solid];
"POJOSalaX4D" -> "POJOSala" [arrowhead=empty, style=solid];
"FiltroTitulo" -> "IFiltroPelicula" [arrowhead=empty, style=dashed];
"FiltroGenero" -> "IFiltroPelicula" [arrowhead=empty, style=dashed];
"FiltroClasificacion" -> "IFiltroPelicula" [arrowhead=empty, style=dashed];
"PagoTarjeta" -> "IMetodoPago" [arrowhead=empty, style=dashed];
"PagoPayPal" -> "IMetodoPago" [arrowhead=empty, style=dashed];
"POJOCine" -> "POJOSala" [arrowtail=diamond, dir=back, arrowhead=vee, label="tiene", taillabel="1", headlabel="1..*"];
"POJOSala" -> "POJOAsiento" [arrowtail=diamond, dir=back, arrowhead=vee, label="tiene", taillabel="1", headlabel="1..*"];
"POJOPelicula" -> "POJOGenero" [arrowhead=vee, label="géneros", taillabel="0..*", headlabel="0..*"];
"POJOPelicula" -> "Clasificacion" [arrowhead=vee, headlabel="1"];
"POJOFuncion" -> "POJOPelicula" [arrowhead=vee, label="proyecta", taillabel="0..*", headlabel="1"];
"POJOFuncion" -> "POJOSala" [arrowhead=vee, label="se da en", taillabel="0..*", headlabel="1"];
"POJOFuncion" -> "POJOCine" [arrowhead=vee, label="en", taillabel="0..*", headlabel="1"];
"POJOFuncion" -> "POJOAsiento" [arrowhead=vee, label="ocupados", headlabel="0..*"];
"POJOFuncion" -> "Idioma" [arrowhead=vee, headlabel="1"];
"POJOCompra" -> "POJOBoleto" [arrowtail=diamond, dir=back, arrowhead=vee, label="incluye", taillabel="1", headlabel="1..10"];
"POJOCompra" -> "POJOCliente" [arrowhead=vee, label="realiza", taillabel="0..*", headlabel="1"];
"POJOCompra" -> "POJOFuncion" [arrowhead=vee, label="para", taillabel="0..*", headlabel="1"];
"POJOCompra" -> "IMetodoPago" [arrowhead=vee, label="se paga con", headlabel="0..1"];
"POJOCompra" -> "EstadoCompra" [arrowhead=vee, headlabel="1"];
"POJOBoleto" -> "POJOAsiento" [arrowhead=vee, label="para", taillabel="0..*", headlabel="1"];
"POJOBoleto" -> "TipoBoleto" [arrowhead=vee, headlabel="1"];
"POJOSala" -> "TipoBoleto" [arrowhead=vee, style=dashed, color="#777777", fontcolor="#777777", label="usa", constraint=false];
}