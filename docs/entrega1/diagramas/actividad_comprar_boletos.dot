a6 [shape=box, style="rounded,filled", fillcolor="#E8F5E9", label="Mostrar \"Asiento ocupado\""];
a7 [shape=box, style="rounded,filled", fillcolor="#E8F5E9", label="Calcular precio (POJOSala.calcularPrecio)\ny agregar boleto a la compra"];
