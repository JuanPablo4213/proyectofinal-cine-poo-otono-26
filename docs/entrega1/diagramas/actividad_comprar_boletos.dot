a14 [shape=box, style="rounded,filled", fillcolor="#E8F5E9", label="Mostrar confirmación y boletos"];
a15 [shape=box, style="rounded,filled", fillcolor="#E8F5E9", label="Compra se queda sin pagar\n(no se ocupa ningún asiento)"];
f [shape=doublecircle, style=filled, fillcolor=black, label="", width=0.22];
f2 [shape=doublecircle, style=filled, fillcolor=black, label="", width=0.22];
i -> a1;
a1 -> d1;
d1 -> a2 [label="no"];
