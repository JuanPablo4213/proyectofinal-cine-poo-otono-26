a8 [shape=box, style="rounded,filled", fillcolor="#E8F5E9", label="Mostrar resumen y total"];
a9 [shape=box, style="rounded,filled", fillcolor="#E3F2FD", label="Elegir método de pago\ny capturar datos"];
d5 [shape=diamond, style=filled, fillcolor="#FFF3E0", label="¿Pago\nválido?", fontsize=10];
a10 [shape=box, style="rounded,filled", fillcolor="#E8F5E9", label="Mostrar error de pago"];
d6 [shape=diamond, style=filled, fillcolor="#FFF3E0", label="¿Reintentar?", fontsize=10];
d7 [shape=diamond, style=filled, fillcolor="#FFF3E0", label="¿Los asientos\nsiguen libres?", fontsize=10];
a11 [shape=box, style="rounded,filled", fillcolor="#E8F5E9", label="Avisar: otro cliente compró\nun asiento; volver a elegir"];
a12 [shape=box, style="rounded,filled", fillcolor="#E8F5E9", label="Ocupar asientos en la función\n(POJOFuncion.ocupar)"];
