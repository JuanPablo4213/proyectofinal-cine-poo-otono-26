digraph A {
graph [rankdir=TB, nodesep=0.4, ranksep=0.35, fontname="Helvetica", label="Diagrama de actividades 2 – Comprar boletos", labelloc=t, fontsize=18, pad=0.3];
node [fontname="Helvetica", fontsize=11];
edge [fontname="Helvetica", fontsize=10, arrowsize=0.8];
i [shape=circle, style=filled, fillcolor=black, label="", width=0.3];
a1 [shape=box, style="rounded,filled", fillcolor="#E3F2FD", label="Seleccionar una función"];
