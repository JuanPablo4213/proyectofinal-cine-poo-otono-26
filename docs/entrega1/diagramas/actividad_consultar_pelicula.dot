digraph A {
graph [rankdir=TB, nodesep=0.4, ranksep=0.35, fontname="Helvetica", label="Diagrama de actividades 1 – Consultar una película y encontrar una función", labelloc=t, fontsize=18, pad=0.3];
node [fontname="Helvetica", fontsize=11];
edge [fontname="Helvetica", fontsize=10, arrowsize=0.8];
i [shape=circle, style=filled, fillcolor=black, label="", width=0.3];
a1 [shape=box, style="rounded,filled", fillcolor="#E3F2FD", label="Abrir la cartelera"];
a2 [shape=box, style="rounded,filled", fillcolor="#E8F5E9", label="Mostrar películas en cartelera\n(ServicioPeliculas.listarCartelera)"];
d1 [shape=diamond, style=filled, fillcolor="#FFF3E0", label="¿Buscar\npor filtro?", fontsize=10];
a3 [shape=box, style="rounded,filled", fillcolor="#E3F2FD", label="Escribir título / género /\nclasificación"];
a4 [shape=box, style="rounded,filled", fillcolor="#E8F5E9", label="Aplicar filtros\n(ServicioPeliculas.buscar)"];
d2 [shape=diamond, style=filled, fillcolor="#FFF3E0", label="¿Hay\nresultados?", fontsize=10];
a5 [shape=box, style="rounded,filled", fillcolor="#E8F5E9", label="Mostrar \"No se encontraron películas\""];
a6 [shape=box, style="rounded,filled", fillcolor="#E3F2FD", label="Seleccionar una película"];
a7 [shape=box, style="rounded,filled", fillcolor="#E8F5E9", label="Mostrar detalle: sinopsis, duración,\nclasificación, género"];
a8 [shape=box, style="rounded,filled", fillcolor="#E3F2FD", label="Seleccionar ciudad y cine"];
a9 [shape=box, style="rounded,filled", fillcolor="#E3F2FD", label="Seleccionar día"];
a10 [shape=box, style="rounded,filled", fillcolor="#E8F5E9", label="Buscar funciones\n(ServicioFunciones.listarPorCineYPelicula)"];
d3 [shape=diamond, style=filled, fillcolor="#FFF3E0", label="¿Hay\nfunciones?", fontsize=10];
a11 [shape=box, style="rounded,filled", fillcolor="#E8F5E9", label="Avisar que no hay funciones\nese día en ese cine"];
d4 [shape=diamond, style=filled, fillcolor="#FFF3E0", label="¿Probar otro\ncine/día?", fontsize=10];
a12 [shape=box, style="rounded,filled", fillcolor="#E8F5E9", label="Mostrar horarios con sala\ne idioma"];
a13 [shape=box, style="rounded,filled", fillcolor="#E3F2FD", label="Seleccionar una función"];
f [shape=doublecircle, style=filled, fillcolor=black, label="", width=0.22];
f2 [shape=doublecircle, style=filled, fillcolor=black, label="", width=0.22];
i -> a1;
a1 -> a2;
a2 -> d1;
d1 -> a3 [label="sí"];
d1 -> a6 [label="no"];
a3 -> a4;
a4 -> d2;
d2 -> a5 [label="no"];
a5 -> a3;
d2 -> a6 [label="sí"];
a6 -> a7;
a7 -> a8;
a8 -> a9;
a9 -> a10;
a10 -> d3;
d3 -> a11 [label="no"];
a11 -> d4;
d4 -> a8 [label="sí"];
d4 -> f2 [label="no"];
d3 -> a12 [label="sí"];
a12 -> a13;
a13 -> f;
leyenda [shape=plain, label=<<TABLE BORDER="0" CELLSPACING="4"><TR><TD BGCOLOR="#E3F2FD" BORDER="1">Acción del usuario</TD><TD BGCOLOR="#E8F5E9" BORDER="1">Acción del sistema</TD><TD BGCOLOR="#FFF3E0" BORDER="1">Decisión</TD></TR></TABLE>>];
}