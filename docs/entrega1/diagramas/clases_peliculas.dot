digraph G {
graph [rankdir=BT, nodesep=0.4, ranksep=0.7, fontname="Helvetica", label="Diagrama de clases – módulo cinemex.peliculas", labelloc=t, fontsize=18, pad=0.3];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9];
"Clasificacion" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF3E0"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Clasificacion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">AA<BR ALIGN="LEFT"/>A<BR ALIGN="LEFT"/>B<BR ALIGN="LEFT"/>B15<BR ALIGN="LEFT"/>C<BR ALIGN="LEFT"/>D<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOPelicula" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF3E0"><B>POJOPelicula</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _id: int<BR ALIGN="LEFT"/>- _titulo: String<BR ALIGN="LEFT"/>- _sinopsis: String<BR ALIGN="LEFT"/>- _genero: String<BR ALIGN="LEFT"/>- _director: String<BR ALIGN="LEFT"/>- _duracionMin: int<BR ALIGN="LEFT"/>- _clasificacion: Clasificacion<BR ALIGN="LEFT"/>- _enCartelera: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ POJOPelicula(id, titulo, sinopsis, genero, director, duracionMin, clasificacion)<BR ALIGN="LEFT"/>+ getters()<BR ALIGN="LEFT"/>+ setEnCartelera(valor: boolean): void<BR ALIGN="LEFT"/>+ toString(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IFiltroPelicula" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF3E0"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B><I>IFiltroPelicula</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ cumple(p: POJOPelicula): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"FiltroTitulo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF3E0"><B>FiltroTitulo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _texto: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ cumple(p: POJOPelicula): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"FiltroGenero" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF3E0"><B>FiltroGenero</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _genero: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ cumple(p: POJOPelicula): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"FiltroClasificacion" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF3E0"><B>FiltroClasificacion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _clasificacion: Clasificacion<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ cumple(p: POJOPelicula): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ServicioPeliculas" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF3E0"><B>ServicioPeliculas</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _peliculas: List&lt;POJOPelicula&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ guardar(obj: POJOPelicula): boolean<BR ALIGN="LEFT"/>+ buscarPorId(id: int): POJOPelicula<BR ALIGN="LEFT"/>+ listar(): List&lt;POJOPelicula&gt;<BR ALIGN="LEFT"/>+ listarCartelera(): List&lt;POJOPelicula&gt;<BR ALIGN="LEFT"/>+ buscar(filtros: List&lt;IFiltroPelicula&gt;): List&lt;POJOPelicula&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"MenuPeliculas" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF3E0"><B>MenuPeliculas</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _servicio: ServicioPeliculas<BR ALIGN="LEFT"/>- _usuarios: ServicioUsuarios<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getTitulo(): String<BR ALIGN="LEFT"/>+ mostrar(sc: Scanner): void<BR ALIGN="LEFT"/>- verCartelera(): void<BR ALIGN="LEFT"/>- buscarPelicula(sc: Scanner): void<BR ALIGN="LEFT"/>- verDetalle(sc: Scanner): void<BR ALIGN="LEFT"/>- agregarPelicula(sc: Scanner): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IMenu" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#ECEFF1" STYLE="dashed"><FONT POINT-SIZE="8">«interface» </FONT>IMenu<BR/><FONT POINT-SIZE="8" COLOR="#666666">(cinemex.base)</FONT></TD></TR></TABLE>>];
"POJOFuncion" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F3E5F5" STYLE="dashed">POJOFuncion<BR/><FONT POINT-SIZE="8" COLOR="#666666">(cinemex.funciones)</FONT></TD></TR></TABLE>>];
"FiltroTitulo" -> "IFiltroPelicula" [arrowhead=empty, style=dashed];
"FiltroGenero" -> "IFiltroPelicula" [arrowhead=empty, style=dashed];
"FiltroClasificacion" -> "IFiltroPelicula" [arrowhead=empty, style=dashed];
"MenuPeliculas" -> "IMenu" [arrowhead=empty, style=dashed];
"POJOFuncion" -> "POJOPelicula" [arrowhead=vee, label="proyecta", taillabel="0..*", headlabel="1"];
"POJOPelicula" -> "Clasificacion" [arrowhead=vee, headlabel="1"];
"ServicioPeliculas" -> "POJOPelicula" [arrowtail=odiamond, dir=back, arrowhead=vee, label="administra", taillabel="1", headlabel="0..*"];
"ServicioPeliculas" -> "IFiltroPelicula" [arrowhead=vee, style=dashed, color="#777777", fontcolor="#777777", label="usa"];
"MenuPeliculas" -> "ServicioPeliculas" [arrowhead=vee, style=dashed, color="#777777", fontcolor="#777777", label="usa"];
}