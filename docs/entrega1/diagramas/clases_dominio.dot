digraph G {
graph [rankdir=BT, splines=true, nodesep=0.35, ranksep=0.6, fontname="Helvetica", label="Diagrama de clases – Clon de Cinemex", labelloc=t, fontsize=20, pad=0.3, newrank=true];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9];
subgraph cluster_usuarios { label="cinemex.usuarios"; style="rounded,dashed"; color="#90A4AE"; fontsize=13; fontcolor="#455A64";
"POJOUsuario" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E3F2FD"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><B><I>POJOUsuario</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># id: int<BR ALIGN="LEFT"/># nombre: String<BR ALIGN="LEFT"/># email: String<BR ALIGN="LEFT"/># password: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ POJOUsuario(id, nombre, email, password)<BR ALIGN="LEFT"/>+ getRol(): String {abstract}<BR ALIGN="LEFT"/>+ validarPassword(password: String): boolean<BR ALIGN="LEFT"/>+ getId(): int<BR ALIGN="LEFT"/>+ getNombre(): String<BR ALIGN="LEFT"/>+ getEmail(): String<BR ALIGN="LEFT"/>+ toString(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOCliente" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E3F2FD"><B>POJOCliente</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _telefono: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ POJOCliente(id, nombre, email, password, telefono)<BR ALIGN="LEFT"/>+ getRol(): String<BR ALIGN="LEFT"/>+ getTelefono(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOAdministrador" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E3F2FD"><B>POJOAdministrador</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _numEmpleado: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ POJOAdministrador(id, nombre, email, password, numEmpleado)<BR ALIGN="LEFT"/>+ getRol(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ServicioUsuarios" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E3F2FD"><B>ServicioUsuarios</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _usuarios: List&lt;POJOUsuario&gt;<BR ALIGN="LEFT"/>- _usuarioActual: POJOUsuario<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ guardar(obj: POJOUsuario): boolean<BR ALIGN="LEFT"/>+ buscarPorId(id: int): POJOUsuario<BR ALIGN="LEFT"/>+ buscarPorEmail(email: String): POJOUsuario<BR ALIGN="LEFT"/>+ listar(): List&lt;POJOUsuario&gt;<BR ALIGN="LEFT"/>+ iniciarSesion(email: String, password: String): POJOUsuario<BR ALIGN="LEFT"/>+ cerrarSesion(): void<BR ALIGN="LEFT"/>+ getUsuarioActual(): POJOUsuario<BR ALIGN="LEFT"/>+ esAdministrador(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_peliculas { label="cinemex.peliculas"; style="rounded,dashed"; color="#90A4AE"; fontsize=13; fontcolor="#455A64";
"Clasificacion" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF3E0"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Clasificacion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">AA<BR ALIGN="LEFT"/>A<BR ALIGN="LEFT"/>B<BR ALIGN="LEFT"/>B15<BR ALIGN="LEFT"/>C<BR ALIGN="LEFT"/>D<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOPelicula" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF3E0"><B>POJOPelicula</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _id: int<BR ALIGN="LEFT"/>- _titulo: String<BR ALIGN="LEFT"/>- _sinopsis: String<BR ALIGN="LEFT"/>- _genero: String<BR ALIGN="LEFT"/>- _director: String<BR ALIGN="LEFT"/>- _duracionMin: int<BR ALIGN="LEFT"/>- _clasificacion: Clasificacion<BR ALIGN="LEFT"/>- _enCartelera: boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ POJOPelicula(id, titulo, sinopsis, genero, director, duracionMin, clasificacion)<BR ALIGN="LEFT"/>+ getters()<BR ALIGN="LEFT"/>+ setEnCartelera(valor: boolean): void<BR ALIGN="LEFT"/>+ toString(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IFiltroPelicula" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF3E0"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B><I>IFiltroPelicula</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ cumple(p: POJOPelicula): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"FiltroTitulo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF3E0"><B>FiltroTitulo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _texto: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ cumple(p: POJOPelicula): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"FiltroGenero" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF3E0"><B>FiltroGenero</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _genero: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ cumple(p: POJOPelicula): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"FiltroClasificacion" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF3E0"><B>FiltroClasificacion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _clasificacion: Clasificacion<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ cumple(p: POJOPelicula): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ServicioPeliculas" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF3E0"><B>ServicioPeliculas</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _peliculas: List&lt;POJOPelicula&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ guardar(obj: POJOPelicula): boolean<BR ALIGN="LEFT"/>+ buscarPorId(id: int): POJOPelicula<BR ALIGN="LEFT"/>+ listar(): List&lt;POJOPelicula&gt;<BR ALIGN="LEFT"/>+ listarCartelera(): List&lt;POJOPelicula&gt;<BR ALIGN="LEFT"/>+ buscar(filtros: List&lt;IFiltroPelicula&gt;): List&lt;POJOPelicula&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_cines { label="cinemex.cines"; style="rounded,dashed"; color="#90A4AE"; fontsize=13; fontcolor="#455A64";
"POJOCine" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8F5E9"><B>POJOCine</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _id: int<BR ALIGN="LEFT"/>- _nombre: String<BR ALIGN="LEFT"/>- _ciudad: String<BR ALIGN="LEFT"/>- _direccion: String<BR ALIGN="LEFT"/>- _salas: List&lt;POJOSala&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ POJOCine(id, nombre, ciudad, direccion)<BR ALIGN="LEFT"/>+ agregarSala(s: POJOSala): boolean<BR ALIGN="LEFT"/>+ tieneSala(s: POJOSala): boolean<BR ALIGN="LEFT"/>+ getSalas(): List&lt;POJOSala&gt;<BR ALIGN="LEFT"/>+ getters()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOSala" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8F5E9"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><B><I>POJOSala</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># id: int<BR ALIGN="LEFT"/># numero: int<BR ALIGN="LEFT"/># filas: int<BR ALIGN="LEFT"/># columnas: int<BR ALIGN="LEFT"/># asientos: List&lt;POJOAsiento&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ POJOSala(id, numero, filas, columnas)<BR ALIGN="LEFT"/>+ calcularPrecio(tipo: TipoBoleto): double {abstract}<BR ALIGN="LEFT"/>+ getTipoSala(): String {abstract}<BR ALIGN="LEFT"/>+ buscarAsiento(fila: char, numero: int): POJOAsiento<BR ALIGN="LEFT"/>+ getCapacidad(): int<BR ALIGN="LEFT"/>+ getAsientos(): List&lt;POJOAsiento&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOSalaTradicional" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8F5E9"><B>POJOSalaTradicional</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- PRECIO_BASE: double = 75 {static}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calcularPrecio(tipo: TipoBoleto): double<BR ALIGN="LEFT"/>+ getTipoSala(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOSalaPlatino" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8F5E9"><B>POJOSalaPlatino</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- PRECIO_BASE: double = 160 {static}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calcularPrecio(tipo: TipoBoleto): double<BR ALIGN="LEFT"/>+ getTipoSala(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOSalaX4D" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8F5E9"><B>POJOSalaX4D</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- PRECIO_BASE: double = 120 {static}<BR ALIGN="LEFT"/>- _cargoEfectos: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calcularPrecio(tipo: TipoBoleto): double<BR ALIGN="LEFT"/>+ getTipoSala(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOAsiento" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8F5E9"><B>POJOAsiento</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _id: int<BR ALIGN="LEFT"/>- _fila: char<BR ALIGN="LEFT"/>- _numero: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ POJOAsiento(id, fila, numero)<BR ALIGN="LEFT"/>+ getCodigo(): String<BR ALIGN="LEFT"/>+ getFila(): char<BR ALIGN="LEFT"/>+ getNumero(): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ServicioCines" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8F5E9"><B>ServicioCines</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _cines: List&lt;POJOCine&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ guardar(obj: POJOCine): boolean<BR ALIGN="LEFT"/>+ buscarPorId(id: int): POJOCine<BR ALIGN="LEFT"/>+ listar(): List&lt;POJOCine&gt;<BR ALIGN="LEFT"/>+ listarPorCiudad(ciudad: String): List&lt;POJOCine&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_funciones { label="cinemex.funciones"; style="rounded,dashed"; color="#90A4AE"; fontsize=13; fontcolor="#455A64";
"Idioma" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F3E5F5"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Idioma</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ESPANOL<BR ALIGN="LEFT"/>SUBTITULADA<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOFuncion" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F3E5F5"><B>POJOFuncion</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _id: int<BR ALIGN="LEFT"/>- _pelicula: POJOPelicula<BR ALIGN="LEFT"/>- _sala: POJOSala<BR ALIGN="LEFT"/>- _fechaHora: LocalDateTime<BR ALIGN="LEFT"/>- _idioma: Idioma<BR ALIGN="LEFT"/>- _asientosOcupados: List&lt;POJOAsiento&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ POJOFuncion(id, pelicula, sala, fechaHora, idioma)<BR ALIGN="LEFT"/>+ estaDisponible(a: POJOAsiento): boolean<BR ALIGN="LEFT"/>+ ocupar(a: POJOAsiento): boolean<BR ALIGN="LEFT"/>+ liberar(a: POJOAsiento): void<BR ALIGN="LEFT"/>+ getAsientosDisponibles(): List&lt;POJOAsiento&gt;<BR ALIGN="LEFT"/>+ calcularHoraFin(): LocalDateTime<BR ALIGN="LEFT"/>+ getters()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ServicioFunciones" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F3E5F5"><B>ServicioFunciones</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _funciones: List&lt;POJOFuncion&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ guardar(obj: POJOFuncion): boolean<BR ALIGN="LEFT"/>+ buscarPorId(id: int): POJOFuncion<BR ALIGN="LEFT"/>+ listar(): List&lt;POJOFuncion&gt;<BR ALIGN="LEFT"/>+ listarPorPelicula(p: POJOPelicula): List&lt;POJOFuncion&gt;<BR ALIGN="LEFT"/>+ listarPorCineYPelicula(c: POJOCine, p: POJOPelicula, dia: LocalDate): List&lt;POJOFuncion&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_compras { label="cinemex.compras"; style="rounded,dashed"; color="#90A4AE"; fontsize=13; fontcolor="#455A64";
"TipoBoleto" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>TipoBoleto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ADULTO<BR ALIGN="LEFT"/>NINO<BR ALIGN="LEFT"/>ADULTO_MAYOR<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"EstadoCompra" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>EstadoCompra</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PENDIENTE<BR ALIGN="LEFT"/>PAGADA<BR ALIGN="LEFT"/>CANCELADA<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOBoleto" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><B>POJOBoleto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _id: int<BR ALIGN="LEFT"/>- _funcion: POJOFuncion<BR ALIGN="LEFT"/>- _asiento: POJOAsiento<BR ALIGN="LEFT"/>- _tipo: TipoBoleto<BR ALIGN="LEFT"/>- _precio: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ POJOBoleto(id, funcion, asiento, tipo, precio)<BR ALIGN="LEFT"/>+ getters()<BR ALIGN="LEFT"/>+ toString(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOCompra" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><B>POJOCompra</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _id: int<BR ALIGN="LEFT"/>- _cliente: POJOCliente<BR ALIGN="LEFT"/>- _funcion: POJOFuncion<BR ALIGN="LEFT"/>- _boletos: List&lt;POJOBoleto&gt;<BR ALIGN="LEFT"/>- _metodo: IMetodoPago<BR ALIGN="LEFT"/>- _estado: EstadoCompra<BR ALIGN="LEFT"/>- _fecha: LocalDateTime<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ POJOCompra(id, cliente, funcion)<BR ALIGN="LEFT"/>+ agregarBoleto(b: POJOBoleto): boolean<BR ALIGN="LEFT"/>+ tieneAsiento(a: POJOAsiento): boolean<BR ALIGN="LEFT"/>+ calcularTotal(): double<BR ALIGN="LEFT"/>+ setMetodo(m: IMetodoPago): void<BR ALIGN="LEFT"/>+ setEstado(e: EstadoCompra): void<BR ALIGN="LEFT"/>+ getters()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IMetodoPago" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B><I>IMetodoPago</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ validar(): boolean<BR ALIGN="LEFT"/>+ calcularComision(monto: double): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PagoTarjeta" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><B>PagoTarjeta</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _numeroTarjeta: String<BR ALIGN="LEFT"/>- _cvv: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ validar(): boolean<BR ALIGN="LEFT"/>+ calcularComision(monto: double): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PagoPayPal" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><B>PagoPayPal</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _correo: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ validar(): boolean<BR ALIGN="LEFT"/>+ calcularComision(monto: double): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ServicioCompras" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><B>ServicioCompras</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _compras: List&lt;POJOCompra&gt;<BR ALIGN="LEFT"/>- MAX_BOLETOS: int = 10 {static}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ iniciarCompra(c: POJOCliente, f: POJOFuncion): POJOCompra<BR ALIGN="LEFT"/>+ agregarBoleto(compra: POJOCompra, a: POJOAsiento, tipo: TipoBoleto): boolean<BR ALIGN="LEFT"/>+ confirmarCompra(compra: POJOCompra, m: IMetodoPago): boolean<BR ALIGN="LEFT"/>+ cancelar(id: int): boolean<BR ALIGN="LEFT"/>+ buscarPorId(id: int): POJOCompra<BR ALIGN="LEFT"/>+ listarPorCliente(c: POJOCliente): List&lt;POJOCompra&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
