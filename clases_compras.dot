digraph G {
graph [rankdir=BT, nodesep=0.4, ranksep=0.7, fontname="Helvetica", label="Diagrama de clases – módulo cinemex.compras", labelloc=t, fontsize=18, pad=0.3];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9];
"TipoBoleto" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>TipoBoleto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ADULTO<BR ALIGN="LEFT"/>NINO<BR ALIGN="LEFT"/>ADULTO_MAYOR<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"EstadoCompra" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>EstadoCompra</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PENDIENTE<BR ALIGN="LEFT"/>PAGADA<BR ALIGN="LEFT"/>CANCELADA<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOBoleto" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><B>POJOBoleto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _id: int<BR ALIGN="LEFT"/>- _funcion: POJOFuncion<BR ALIGN="LEFT"/>- _asiento: POJOAsiento<BR ALIGN="LEFT"/>- _tipo: TipoBoleto<BR ALIGN="LEFT"/>- _precio: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ POJOBoleto(id, funcion, asiento, tipo, precio)<BR ALIGN="LEFT"/>+ getters()<BR ALIGN="LEFT"/>+ toString(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOCompra" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><B>POJOCompra</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _id: int<BR ALIGN="LEFT"/>- _cliente: POJOCliente<BR ALIGN="LEFT"/>- _funcion: POJOFuncion<BR ALIGN="LEFT"/>- _boletos: List&lt;POJOBoleto&gt;<BR ALIGN="LEFT"/>- _metodo: IMetodoPago<BR ALIGN="LEFT"/>- _estado: EstadoCompra<BR ALIGN="LEFT"/>- _fecha: LocalDateTime<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ POJOCompra(id, cliente, funcion)<BR ALIGN="LEFT"/>+ agregarBoleto(b: POJOBoleto): boolean<BR ALIGN="LEFT"/>+ tieneAsiento(a: POJOAsiento): boolean<BR ALIGN="LEFT"/>+ calcularTotal(): double<BR ALIGN="LEFT"/>+ setMetodo(m: IMetodoPago): void<BR ALIGN="LEFT"/>+ setEstado(e: EstadoCompra): void<BR ALIGN="LEFT"/>+ getters()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IMetodoPago" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><FONT POINT-SIZE="9">«interface»</FONT><BR/><B><I>IMetodoPago</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ validar(): boolean<BR ALIGN="LEFT"/>+ calcularComision(monto: double): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PagoTarjeta" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><B>PagoTarjeta</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _numeroTarjeta: String<BR ALIGN="LEFT"/>- _cvv: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ validar(): boolean<BR ALIGN="LEFT"/>+ calcularComision(monto: double): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PagoPayPal" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><B>PagoPayPal</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _correo: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ validar(): boolean<BR ALIGN="LEFT"/>+ calcularComision(monto: double): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ServicioCompras" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><B>ServicioCompras</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _compras: List&lt;POJOCompra&gt;<BR ALIGN="LEFT"/>- MAX_BOLETOS: int = 10 {static}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ iniciarCompra(c: POJOCliente, f: POJOFuncion): POJOCompra<BR ALIGN="LEFT"/>+ agregarBoleto(compra: POJOCompra, a: POJOAsiento, tipo: TipoBoleto): boolean<BR ALIGN="LEFT"/>+ confirmarCompra(compra: POJOCompra, m: IMetodoPago): boolean<BR ALIGN="LEFT"/>+ cancelar(id: int): boolean<BR ALIGN="LEFT"/>+ buscarPorId(id: int): POJOCompra<BR ALIGN="LEFT"/>+ listarPorCliente(c: POJOCliente): List&lt;POJOCompra&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"MenuCompras" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFEBEE"><B>MenuCompras</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _servicio: ServicioCompras<BR ALIGN="LEFT"/>- _funciones: ServicioFunciones<BR ALIGN="LEFT"/>- _usuarios: ServicioUsuarios<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getTitulo(): String<BR ALIGN="LEFT"/>+ mostrar(sc: Scanner): void<BR ALIGN="LEFT"/>- comprarBoletos(sc: Scanner): void<BR ALIGN="LEFT"/>- verMisCompras(): void<BR ALIGN="LEFT"/>- cancelarCompra(sc: Scanner): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IMenu" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#ECEFF1" STYLE="dashed"><FONT POINT-SIZE="8">«interface» </FONT>IMenu<BR/><FONT POINT-SIZE="8" COLOR="#666666">(cinemex.base)</FONT></TD></TR></TABLE>>];
"POJOCliente" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E3F2FD" STYLE="dashed">POJOCliente<BR/><FONT POINT-SIZE="8" COLOR="#666666">(cinemex.usuarios)</FONT></TD></TR></TABLE>>];
"POJOSala" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F5E9" STYLE="dashed"><FONT POINT-SIZE="8">«abstract» </FONT>POJOSala<BR/><FONT POINT-SIZE="8" COLOR="#666666">(cinemex.cines)</FONT></TD></TR></TABLE>>];
"POJOAsiento" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E8F5E9" STYLE="dashed">POJOAsiento<BR/><FONT POINT-SIZE="8" COLOR="#666666">(cinemex.cines)</FONT></TD></TR></TABLE>>];
"POJOFuncion" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F3E5F5" STYLE="dashed">POJOFuncion<BR/><FONT POINT-SIZE="8" COLOR="#666666">(cinemex.funciones)</FONT></TD></TR></TABLE>>];
"PagoTarjeta" -> "IMetodoPago" [arrowhead=empty, style=dashed];
"PagoPayPal" -> "IMetodoPago" [arrowhead=empty, style=dashed];
"MenuCompras" -> "IMenu" [arrowhead=empty, style=dashed];
"POJOCompra" -> "POJOBoleto" [arrowtail=diamond, dir=back, arrowhead=vee, label="incluye", taillabel="1", headlabel="1..10"];
"POJOCompra" -> "POJOCliente" [arrowhead=vee, label="realiza", taillabel="0..*", headlabel="1"];
"POJOCompra" -> "POJOFuncion" [arrowhead=vee, label="para", taillabel="0..*", headlabel="1"];
"POJOCompra" -> "IMetodoPago" [arrowhead=vee, label="se paga con", headlabel="0..1"];
"POJOCompra" -> "EstadoCompra" [arrowhead=vee, headlabel="1"];
"POJOBoleto" -> "POJOAsiento" [arrowhead=vee, label="para", taillabel="0..*", headlabel="1"];
"POJOBoleto" -> "TipoBoleto" [arrowhead=vee, headlabel="1"];
"POJOSala" -> "TipoBoleto" [arrowhead=vee, style=dashed, color="#777777", fontcolor="#777777", label="usa"];
"ServicioCompras" -> "POJOCompra" [arrowtail=odiamond, dir=back, arrowhead=vee, label="administra", taillabel="1", headlabel="0..*"];
"MenuCompras" -> "ServicioCompras" [arrowhead=vee, style=dashed, color="#777777", fontcolor="#777777", label="usa"];
}