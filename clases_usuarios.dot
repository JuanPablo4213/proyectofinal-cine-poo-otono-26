digraph G {
graph [rankdir=BT, nodesep=0.4, ranksep=0.7, fontname="Helvetica", label="Diagrama de clases – módulo cinemex.usuarios", labelloc=t, fontsize=18, pad=0.3];
node [shape=plain, fontname="Helvetica", fontsize=10];
edge [fontname="Helvetica", fontsize=9];
"POJOUsuario" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E3F2FD"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><B><I>POJOUsuario</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># id: int<BR ALIGN="LEFT"/># nombre: String<BR ALIGN="LEFT"/># email: String<BR ALIGN="LEFT"/># password: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ POJOUsuario(id, nombre, email, password)<BR ALIGN="LEFT"/>+ getRol(): String {abstract}<BR ALIGN="LEFT"/>+ validarPassword(password: String): boolean<BR ALIGN="LEFT"/>+ getId(): int<BR ALIGN="LEFT"/>+ getNombre(): String<BR ALIGN="LEFT"/>+ getEmail(): String<BR ALIGN="LEFT"/>+ toString(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOCliente" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E3F2FD"><B>POJOCliente</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _telefono: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ POJOCliente(id, nombre, email, password, telefono)<BR ALIGN="LEFT"/>+ getRol(): String<BR ALIGN="LEFT"/>+ getTelefono(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"POJOAdministrador" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E3F2FD"><B>POJOAdministrador</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _numEmpleado: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ POJOAdministrador(id, nombre, email, password, numEmpleado)<BR ALIGN="LEFT"/>+ getRol(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"ServicioUsuarios" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E3F2FD"><B>ServicioUsuarios</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _usuarios: List&lt;POJOUsuario&gt;<BR ALIGN="LEFT"/>- _usuarioActual: POJOUsuario<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ guardar(obj: POJOUsuario): boolean<BR ALIGN="LEFT"/>+ buscarPorId(id: int): POJOUsuario<BR ALIGN="LEFT"/>+ buscarPorEmail(email: String): POJOUsuario<BR ALIGN="LEFT"/>+ listar(): List&lt;POJOUsuario&gt;<BR ALIGN="LEFT"/>+ iniciarSesion(email: String, password: String): POJOUsuario<BR ALIGN="LEFT"/>+ cerrarSesion(): void<BR ALIGN="LEFT"/>+ getUsuarioActual(): POJOUsuario<BR ALIGN="LEFT"/>+ esAdministrador(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"MenuUsuarios" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E3F2FD"><B>MenuUsuarios</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _servicio: ServicioUsuarios<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getTitulo(): String<BR ALIGN="LEFT"/>+ mostrar(sc: Scanner): void<BR ALIGN="LEFT"/>- registrarCliente(sc: Scanner): void<BR ALIGN="LEFT"/>- iniciarSesion(sc: Scanner): void<BR ALIGN="LEFT"/>- cerrarSesion(): void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"IMenu" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#ECEFF1" STYLE="dashed"><FONT POINT-SIZE="8">«interface» </FONT>IMenu<BR/><FONT POINT-SIZE="8" COLOR="#666666">(cinemex.base)</FONT></TD></TR></TABLE>>];
"POJOCompra" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FFEBEE" STYLE="dashed">POJOCompra<BR/><FONT POINT-SIZE="8" COLOR="#666666">(cinemex.compras)</FONT></TD></TR></TABLE>>];
"POJOCliente" -> "POJOUsuario" [arrowhead=empty, style=solid];
"POJOAdministrador" -> "POJOUsuario" [arrowhead=empty, style=solid];
"MenuUsuarios" -> "IMenu" [arrowhead=empty, style=dashed];
"POJOCompra" -> "POJOCliente" [arrowhead=vee, label="realiza", taillabel="0..*", headlabel="1"];
"ServicioUsuarios" -> "POJOUsuario" [arrowtail=odiamond, dir=back, arrowhead=vee, label="administra", taillabel="1", headlabel="0..*"];
"MenuUsuarios" -> "ServicioUsuarios" [arrowhead=vee, style=dashed, color="#777777", fontcolor="#777777", label="usa"];
}